-		EVP_EncryptInit_ex(evp_ctx, EVP_aes_192_ctr(), NULL, aes_mt_ctx->orig_key, NULL);
-	else
-		fatal("Invalid key length of %d in AES CTR MT. Exiting", aes_mt_ctx->keylen);
 
 	/*
 	 * Handle the special case of startup, one thread must fill
