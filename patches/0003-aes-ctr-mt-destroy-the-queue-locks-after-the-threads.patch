From f74a144db233eaaff31dbf3808719a2f46042b93 Mon Sep 17 00:00:00 2001
From: Richard Spindler <richard@lateralblast.com.au>
Date: Tue, 3 Nov 2026 18:20:19 +1100
Subject: [PATCH] aes-ctr-mt: destroy the queue locks after the threads are
 joined

The queue mutexes and condition variables were destroyed before
pthread_join() in cipher-ctr-mt.c, which is undefined while a thread may
still be waiting on them, and were never destroyed in
cipher-ctr-mt-functions.c, so every rekey and every freed context leaked
them. Destroy them, and the stop lock, when the context is freed, after
every thread has been joined.

Changelog: sphynx 0.0.7

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 cipher-ctr-mt-functions.c |  8 ++++++++
 cipher-ctr-mt.c           | 10 ++++++++++
 2 files changed, 18 insertions(+)

diff --git a/cipher-ctr-mt-functions.c b/cipher-ctr-mt-functions.c
index d6bd4f3a6..9f7acfd36 100644
--- a/cipher-ctr-mt-functions.c
+++ b/cipher-ctr-mt-functions.c
@@ -384,10 +384,18 @@ void aes_mt_freectx(void *vevp_ctx)
 {
 	EVP_CIPHER_CTX *evp_ctx = vevp_ctx;
 	struct aes_mt_ctx_st *aes_mt_ctx;
+	int i;
 
 	if ((aes_mt_ctx = EVP_CIPHER_CTX_get_app_data(evp_ctx)) != NULL) {
 		stop_and_join_pregen_threads(aes_mt_ctx);
 
+		/* All threads are joined, so nothing can use the locks now */
+		for (i = 0; i < aes_mt_ctx->numkq; i++) {
+			pthread_mutex_destroy(&aes_mt_ctx->q[i].lock);
+			pthread_cond_destroy(&aes_mt_ctx->q[i].cond);
+		}
+		pthread_rwlock_destroy(&aes_mt_ctx->stop_lock);
+
 		explicit_bzero(aes_mt_ctx, sizeof(*aes_mt_ctx));
 		free(aes_mt_ctx);
 		EVP_CIPHER_CTX_set_app_data(evp_ctx, NULL);
diff --git a/cipher-ctr-mt.c b/cipher-ctr-mt.c
index 9b524e296..4e56d26b4 100644
--- a/cipher-ctr-mt.c
+++ b/cipher-ctr-mt.c
@@ -634,10 +634,20 @@ static int
 ssh_aes_ctr_cleanup(EVP_CIPHER_CTX *ctx)
 {
 	struct ssh_aes_ctr_ctx_mt *c;
+	int i;
 
 	if ((c = EVP_CIPHER_CTX_get_app_data(ctx)) != NULL) {
 		stop_and_join_pregen_threads(c);
 
+		/* All threads are joined, so nothing can use the locks now */
+		for (i = 0; i < c->numkq; i++) {
+			pthread_mutex_destroy(&c->q[i].lock);
+			pthread_cond_destroy(&c->q[i].cond);
+		}
+#ifdef __APPLE__
+		pthread_rwlock_destroy(&c->stop_lock);
+#endif /* __APPLE__ */
+
 		explicit_bzero(c, sizeof(*c));
 		free(c);
 		EVP_CIPHER_CTX_set_app_data(ctx, NULL);
