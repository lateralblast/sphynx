From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Richard Spindler <richard@lateralblast.com.au>
Date: Thu, 5 Nov 2026 12:00:00 +1100
Subject: [PATCH 34/55] cipher: stop taking a reference on every cipher start

Three places took a reference to an OpenSSL object and never gave it back:

 - kex_choose_conf() called match_list() only to test the result for NULL and
   dropped the string it returned, on every key exchange. It uses
   kex_has_any_alg() now, which frees it.
 - cipher_init() added and loaded the hpnssh provider and fetched the
   multithreaded AES-CTR cipher on every start. They are loaded and fetched
   once for the life of the process now.
 - chachapoly_new() fetched the POLY1305 MAC and kept the reference after the
   MAC context had taken its own.

The OpenSSL objects are cached, so the references were a counter and not
growing memory; the string from match_list() was a real, small, allocation.
---
 cipher-chachapoly-libcrypto.c |  5 +++-
 cipher.c                      | 52 +++++++++++++++++++----------------
 kex.c                         |  4 +--
 3 files changed, 35 insertions(+), 26 deletions(-)

diff --git a/cipher-chachapoly-libcrypto.c b/cipher-chachapoly-libcrypto.c
index bd48052a6..f1ca03c85 100644
--- a/cipher-chachapoly-libcrypto.c
+++ b/cipher-chachapoly-libcrypto.c
@@ -68,7 +68,10 @@ chachapoly_new(const u_char *key, u_int keylen)
 	EVP_MAC *mac = NULL;
 	if ((mac = EVP_MAC_fetch(NULL, "POLY1305", NULL)) == NULL)
 		goto fail;
-	if ((ctx->poly_ctx = EVP_MAC_CTX_new(mac)) == NULL)
+	ctx->poly_ctx = EVP_MAC_CTX_new(mac);
+	/* the context holds its own reference to the MAC; drop ours */
+	EVP_MAC_free(mac);
+	if (ctx->poly_ctx == NULL)
 		goto fail;
 #else
 	ctx->poly_ctx = NULL;
diff --git a/cipher.c b/cipher.c
index bbfff0f83..be1440f47 100644
--- a/cipher.c
+++ b/cipher.c
@@ -386,35 +386,41 @@ cipher_init(struct sshcipher_ctx **ccp, const struct sshcipher *cipher,
 	 * _meth_new process found in cipher-ctr-mt.c */
 	if (strstr(cc->cipher->name, "ctr") && enable_threads) {
 #ifdef WITH_OPENSSL3
-		/* this version of openssl uses providers */
-		OSSL_LIB_CTX *aes_lib = NULL; /* probably not needed */
-		OSSL_PROVIDER *aes_mt_provider = NULL;
+		/* this version of openssl uses providers. The provider is
+		 * added and loaded, and each cipher fetched, once for the
+		 * life of the process: doing it on every init, as this used
+		 * to, took a new reference to each and never gave it back */
+		static OSSL_PROVIDER *aes_mt_provider = NULL;
+		static EVP_CIPHER *aes_mt_fetched[3]; /* 128, 192 and 256 bit */
+		const char *aes_mt_names[3] = { "aes_ctr_mt_128",
+		    "aes_ctr_mt_192", "aes_ctr_mt_256" };
+		int ki = cipher->key_len == 16 ? 0 :
+		    cipher->key_len == 24 ? 1 : cipher->key_len == 32 ? 2 : -1;
 		type = NULL;
 
-		if (OSSL_PROVIDER_add_builtin(aes_lib, "hpnssh",
-					      OSSL_provider_init) != 1) {
-			fatal("Failed to add HPNSSH provider for AES-CTR");
-		}
-		aes_mt_provider = OSSL_PROVIDER_load(aes_lib, "hpnssh");
-
-		if (aes_mt_provider != NULL) {
-			/* use the previous key length to determine which cipher to load */
-			if (cipher->key_len == 32)
-				type = EVP_CIPHER_fetch(aes_lib, "aes_ctr_mt_256", NULL);
-			if (cipher->key_len == 24)
-				type = EVP_CIPHER_fetch(aes_lib, "aes_ctr_mt_192", NULL);
-			if (cipher->key_len == 16)
-				type = EVP_CIPHER_fetch(aes_lib, "aes_ctr_mt_128", NULL);
-			if (type == NULL) {
+		if (aes_mt_provider == NULL) {
+			if (OSSL_PROVIDER_add_builtin(NULL, "hpnssh",
+			    OSSL_provider_init) != 1) {
+				fatal("Failed to add HPNSSH provider for AES-CTR");
+			}
+			if ((aes_mt_provider = OSSL_PROVIDER_load(NULL,
+			    "hpnssh")) == NULL) {
 				ERR_print_errors_fp(stderr);
-				fatal("FAILED TO LOAD aes_ctr_mt");
-			} else {
-				debug("LOADED aes_ctr_mt");
+				fatal("Failed to load HPN-SSH AES-CTR-MT provider.");
 			}
 		}
-		else {
+		/* use the key length to determine which cipher to load */
+		if (ki >= 0) {
+			if (aes_mt_fetched[ki] == NULL)
+				aes_mt_fetched[ki] = EVP_CIPHER_fetch(NULL,
+				    aes_mt_names[ki], NULL);
+			type = aes_mt_fetched[ki];
+		}
+		if (type == NULL) {
 			ERR_print_errors_fp(stderr);
-			fatal("Failed to load HPN-SSH AES-CTR-MT provider.");
+			fatal("FAILED TO LOAD aes_ctr_mt");
+		} else {
+			debug("LOADED aes_ctr_mt");
 		}
 #else
 		type = (*evp_aes_ctr_mt)(); /* see cipher-ctr-mt.c */
diff --git a/kex.c b/kex.c
index 229a90a9f..07790fd06 100644
--- a/kex.c
+++ b/kex.c
@@ -1151,8 +1151,8 @@ kex_choose_conf(struct ssh *ssh, uint32_t seq)
 		}
 #ifdef WITH_OPENSSL
 		if ((strcmp(newkeys->enc.name, "chacha20-poly1305@openssh.com")
-		    == 0) && (match_list("chacha20-poly1305-mt@hpnssh.org",
-		    my[nenc], NULL) != NULL)) {
+		    == 0) && kex_has_any_alg(my[nenc],
+		    "chacha20-poly1305-mt@hpnssh.org")) {
 			/*
 			 * if we're using the serial CC20 cipher while the
 			 * multithreaded implementation is an option...
-- 
