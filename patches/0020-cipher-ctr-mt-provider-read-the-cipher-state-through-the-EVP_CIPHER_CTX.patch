From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Richard Spindler <richard@lateralblast.com.au>
Date: Wed, 4 Nov 2026 18:30:00 +1100
Subject: [PATCH] cipher-ctr-mt-provider: read the cipher state through the
 EVP_CIPHER_CTX

The multithreaded AES-CTR provider hands libcrypto an EVP_CIPHER_CTX as its
context and keeps its real state (struct aes_mt_ctx_st) as that context's app
data. aes_mt_do_cipher, aes_mt_start_threads and aes_mt_freectx all fetch the
state that way, but aes_mt_get_ctx_params and aes_mt_set_ctx_params used the
pointer they were given as the state itself. They read keylen, and in the set
case ongoing and keylen, from the wrong memory: ongoing is 17311908 bytes into
the state, so it was read 17 MB past the end of a small EVP_CIPHER_CTX
allocation, and keylen was written over a field of the EVP_CIPHER_CTX.

The bad reads and writes went unnoticed with OpenSSL 3.5, where a connection
did not fault. With OpenSSL 4.1 every aes-ctr connection died with a bus error
in aes_mt_set_ctx_params, at an address exactly offsetof(ongoing) past the
context pointer.

Fetch the state through the app data in both functions, return an error if
there is none, and convert between the bytes libcrypto uses for the keylen
parameter and the bits the state keeps.

tests/c/aes_ctr_mt_init.c starts every key size through cipher_init() with
threads, both directions, and compares the output with the unthreaded cipher.
It crashes with OpenSSL 4.1 without this change and passes with it.
---
 cipher-ctr-mt-provider.c | 26 ++++++++++++++++++++++----
 1 file changed, 22 insertions(+), 4 deletions(-)

diff --git a/cipher-ctr-mt-provider.c b/cipher-ctr-mt-provider.c
index 8b4e00a46..ea5eb2d01 100644
--- a/cipher-ctr-mt-provider.c
+++ b/cipher-ctr-mt-provider.c
@@ -339,17 +339,31 @@ static const OSSL_PARAM *aes_mt_gettable_ctx_params(void *cctx, void *provctx)
 	return ctx_get_param_table;
 }
 
+/* The context libcrypto holds for this cipher is an EVP_CIPHER_CTX (see
+ * aes_mt_newctx), and the real state is its app data. Every function that
+ * takes the context has to unwrap it first: reading it as the state itself
+ * reads and writes memory that is not ours, and a field 17 MB into the state
+ * lies far outside the small EVP_CIPHER_CTX it really is. */
+static struct aes_mt_ctx_st *aes_mt_state(void *vctx)
+{
+    return EVP_CIPHER_CTX_get_app_data((EVP_CIPHER_CTX *)vctx);
+}
+
 static int aes_mt_get_ctx_params(void *vctx, OSSL_PARAM params[])
 {
-    struct aes_mt_ctx_st *ctx = vctx;
+    struct aes_mt_ctx_st *ctx = aes_mt_state(vctx);
     int ok = 1;
 
+    if (ctx == NULL)
+        return 0;
+
+    /* the state counts key bits, the parameter is in bytes */
     if (ctx->keylen > 0) {
         OSSL_PARAM *p;
 
         for (p = params; p->key != NULL; p++)
             if (strcasecmp(p->key, "keylen") == 0
-                && provnum_set_size_t(p, ctx->keylen) < 0) {
+                && provnum_set_size_t(p, ctx->keylen / 8) < 0) {
                 ok = 0;
                 continue;
             }
@@ -365,10 +379,13 @@ static const OSSL_PARAM *aes_mt_settable_ctx_params(void *cctx, void *provctx)
 
 static int aes_mt_set_ctx_params(void *vctx, const OSSL_PARAM params[])
 {
-    struct aes_mt_ctx_st *ctx = vctx;
+    struct aes_mt_ctx_st *ctx = aes_mt_state(vctx);
     const OSSL_PARAM *p;
     int ok = 1;
 
+    if (ctx == NULL)
+        return 0;
+
     if (ctx->ongoing) {
         ERR_raise(ERR_HANDLE(ctx), AES_MT_ONGOING_OPERATION);
         return 0;
@@ -382,7 +399,8 @@ static int aes_mt_set_ctx_params(void *vctx, const OSSL_PARAM params[])
                 ok = 0;
                 continue;
             }
-            ctx->keylen = keyl;
+            /* the parameter is in bytes, the state counts bits */
+            ctx->keylen = keyl * 8;
         }
     return ok;
 }
-- 
2.50.0
