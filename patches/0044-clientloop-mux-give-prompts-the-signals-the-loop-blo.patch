From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Richard Spindler <richard@lateralblast.com.au>
Date: Thu, 5 Nov 2026 12:00:00 +1100
Subject: [PATCH 43/55] clientloop, mux: give prompts the signals the loop
 blocks

client_loop() blocks HUP, INT, QUIT and TERM for the whole loop and unblocks
them only inside ppoll(). Patch 0027 gave the commands the loop starts a clean
mask, but the prompts it runs were left out: the "Allow shared connection?"
questions of ControlMaster ask and auto-ask (mux.c), the ~C command line and
the UpdateHostKeys ask. Each ran with the signals blocked, so Ctrl-C did not
interrupt the prompt, and the askpass program started for it (SSH_ASKPASS)
inherited the blocked mask across exec and ignored the signals.

Export the swap helpers from clientloop.c and use them around those prompts;
mux.c gets a mux_ask_permission() that wraps ask_permission().
---
 clientloop.c | 29 ++++++++++++++++++-----------
 clientloop.h |  3 +++
 mux.c        | 36 +++++++++++++++++++++++++++++-------
 3 files changed, 50 insertions(+), 18 deletions(-)

diff --git a/clientloop.c b/clientloop.c
index b538fdd00..2c6b78296 100644
--- a/clientloop.c
+++ b/clientloop.c
@@ -166,17 +166,17 @@ static int session_setup_complete;
  */
 static const sigset_t *loop_child_sigmask;
 
-/* Give the caller the mask a child should start with; see child_sigmask_end() */
-static int
-child_sigmask_begin(sigset_t *saved)
+/* Give the caller the mask a child should start with; see client_sigmask_end() */
+int
+client_sigmask_begin(sigset_t *saved)
 {
 	if (loop_child_sigmask == NULL)
 		return 0;
 	return sigprocmask(SIG_SETMASK, loop_child_sigmask, saved) == 0;
 }
 
-static void
-child_sigmask_end(int swapped, const sigset_t *saved)
+void
+client_sigmask_end(int swapped, const sigset_t *saved)
 {
 	if (swapped && sigprocmask(SIG_SETMASK, saved, NULL) == -1)
 		error_f("sigprocmask: %s", strerror(errno));
@@ -417,10 +417,10 @@ client_x11_get_proto(struct ssh *ssh, const char *display,
 				channel_set_x11_refuse_time(ssh,
 				    x11_refuse_time);
 			}
-			swapped = child_sigmask_begin(&saved_sigs);
+			swapped = client_sigmask_begin(&saved_sigs);
 			if (system(cmd) == 0)
 				generated = 1;
-			child_sigmask_end(swapped, &saved_sigs);
+			client_sigmask_end(swapped, &saved_sigs);
 			free(cmd);
 		}
 
@@ -437,9 +437,9 @@ client_x11_get_proto(struct ssh *ssh, const char *display,
 			    generated ? xauthfile : "",
 			    display);
 			debug2("x11_get_proto: %s", cmd);
-			swapped = child_sigmask_begin(&saved_sigs);
+			swapped = client_sigmask_begin(&saved_sigs);
 			f = popen(cmd, "r");
-			child_sigmask_end(swapped, &saved_sigs);
+			client_sigmask_end(swapped, &saved_sigs);
 			if (f && fgets(line, sizeof(line), f) &&
 			    sscanf(line, "%*s %511s %511s", proto, data) == 2)
