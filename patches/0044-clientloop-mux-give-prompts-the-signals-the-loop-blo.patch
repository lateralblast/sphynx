@@ -1031,7 +1031,10 @@ process_cmdline(struct ssh *ssh)
 
 	leave_raw_mode(options.request_tty == REQUEST_TTY_FORCE);
 	handler = ssh_signal(SIGINT, SIG_IGN);
+	/* a prompt must be interruptible, and its askpass must not start blocked */
+	swapped = client_sigmask_begin(&saved_sigs);
 	cmd = s = read_passphrase("\r\nssh> ", RP_ECHO);
+	client_sigmask_end(swapped, &saved_sigs);
 	if (s == NULL)
 		goto out;
 	while (isspace((u_char)*s))
@@ -1064,9 +1067,9 @@ process_cmdline(struct ssh *ssh)
 
 	if (*s == '!' && options.permit_local_command) {
 		s++;
-		swapped = child_sigmask_begin(&saved_sigs);
+		swapped = client_sigmask_begin(&saved_sigs);
 		ssh_local_cmd(s);
-		child_sigmask_end(swapped, &saved_sigs);
+		client_sigmask_end(swapped, &saved_sigs);
 		goto out;
 	}
 
@@ -2350,6 +2353,8 @@ update_known_hosts(struct hostkeys_update_ctx *ctx)
 	char *fp, *response;
 	size_t i;
 	struct stat sb;
+	sigset_t saved_sigs;
+	int swapped;
 
 	for (i = 0; i < ctx->nkeys; i++) {
 		if (!ctx->keys_verified[i])
@@ -2383,8 +2388,10 @@ update_known_hosts(struct hostkeys_update_ctx *ctx)
 		response = NULL;
 		for (i = 0; !quit_pending && i < 3; i++) {
 			free(response);
+			swapped = client_sigmask_begin(&saved_sigs);
 			response = read_passphrase("Accept updated hostkeys? "
 			    "(yes/no): ", RP_ECHO);
+			client_sigmask_end(swapped, &saved_sigs);
 			if (response != NULL && strcasecmp(response, "yes") == 0)
 				break;
 			else if (quit_pending || response == NULL ||
diff --git a/clientloop.h b/clientloop.h
index 51c8cfb35..bdec08345 100644
--- a/clientloop.h
+++ b/clientloop.h
@@ -41,6 +41,9 @@ struct ssh;
 
 /* Client side main loop for the interactive session. */
 int	 client_loop(struct ssh *, int, int, int);
+/* run a prompt or a child with the signals the loop blocks unblocked; see clientloop.c */
+int	 client_sigmask_begin(sigset_t *);
+void	 client_sigmask_end(int, const sigset_t *);
 int	 client_x11_get_proto(struct ssh *, const char *, const char *,
 	    u_int, u_int, char **, char **);
 void	 client_session2_setup(struct ssh *, int, int, int,
diff --git a/mux.c b/mux.c
index d06fadefe..c9157a597 100644
--- a/mux.c
+++ b/mux.c
@@ -181,6 +181,28 @@ static const struct {
 	{ 0, NULL }
 };
 
+/*
+ * Ask the user, from inside the client loop. The loop keeps HUP, INT, QUIT and
+ * TERM blocked, which would make the prompt uninterruptible and start its
+ * askpass program with them blocked, so give them back for the prompt.
+ */
+static int
+mux_ask_permission(const char *fmt, ...)
+{
+	va_list args;
+	char prompt[1024];
+	sigset_t saved;
+	int swapped, r;
+
+	va_start(args, fmt);
+	vsnprintf(prompt, sizeof(prompt), fmt, args);
+	va_end(args);
+	swapped = client_sigmask_begin(&saved);
+	r = ask_permission("%s", prompt);
+	client_sigmask_end(swapped, &saved);
+	return r;
+}
+
 /* Cleanup callback fired on closure of mux client _session_ channel */
 static void
 mux_master_session_cleanup_cb(struct ssh *ssh, int cid, int force, void *unused)
@@ -446,7 +468,7 @@ mux_master_process_new_session(struct ssh *ssh, u_int rid,
 
 	if (options.control_master == SSHCTL_MASTER_ASK ||
