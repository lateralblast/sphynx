+void	warnx(const char *, ...) __cold __printflike(1, 2);
+void	vwarnx(const char *, __darwin_va_list) __cold __printflike(1, 0);
+void	err_set_file(void *);
+void	err_set_exit(void (* _Nullable)(int));
