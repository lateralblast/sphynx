+  if (binn_object_get_pair(ptr, pos, pkey, &value) == FALSE) return NULL;
+  if (ptype) *ptype = value.type;
+  if (psize) *psize = value.size;
+#if BYTE_ORDER == LITTLE_ENDIAN
+  return store_value(&value);
+#else
+  return value.ptr;
+#endif
+
