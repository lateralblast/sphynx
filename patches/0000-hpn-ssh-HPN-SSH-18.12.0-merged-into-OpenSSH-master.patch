+	if start-stop-daemon --start --quiet --oknodo --chuid 0:0 --pidfile ${PIDFILE} --exec ${HPNSSHD} -- $SSHD_OPTS; then
+            log_end_msg 0 || true
+        else
+            log_end_msg 1 || true
+        fi
