From 2a0d858ffdf2118883d217311c910a70ecddec77 Mon Sep 17 00:00:00 2001
From: Richard Spindler <richard@lateralblast.com.au>
Date: Tue, 3 Nov 2026 18:20:19 +1100
Subject: [PATCH] scp: build the -Z temporary name in its own buffer

In -Z resume mode the data is received into a temporary file whose name was
made by strcat()ing a random string onto np. When the destination is a plain
file, np is the caller's argument string, which has no room for it: a buffer
overflow, and the suffix then stayed on the destination name for the rest of
the transfer. The directory case has 250 bytes of slack and was safe.

Build the name in its own allocated buffer, create the file with O_EXCL so an
existing name is never followed or reused, and make the random part with
arc4random_uniform() instead of rand() seeded from the clock.

Changelog: sphynx 0.2.1

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 scp.c | 23 +++++++++++++++++------
 1 file changed, 17 insertions(+), 6 deletions(-)

diff --git a/scp.c b/scp.c
index 51c53bbc0..9da45a607 100644
--- a/scp.c
+++ b/scp.c
@@ -1931,7 +1931,7 @@ sink(int argc, char **argv, const char *src)
 	off_t size, statbytes, xfer_size;
 	unsigned long long ull;
 	int setimes, targisdir, wrerr;
-	char ch, *cp, *np, *np_tmp, *targ, *why, *vect[1], buf[16384], visbuf[16384];
+	char ch, *cp, *np, *np_tmp, *np_rand, *targ, *why, *vect[1], buf[16384], visbuf[16384];
 	char **patterns = NULL;
 	size_t n, npatterns = 0;
 	struct timeval tv[2];
@@ -1943,6 +1943,7 @@ sink(int argc, char **argv, const char *src)
 	int bad_match_flag = 0;
 	np = NULL; /* this was originally '/0' but that's wrong */
 	np_tmp = NULL;
+	np_rand = NULL;
 
 
 #define	atime	tv[0]
@@ -2313,10 +2314,16 @@ sink(int argc, char **argv, const char *src)
 				xfer_size = size - npstat.st_size;
 				resume_flag = 1;
 				np_tmp = xstrdup(np);
-				/* We should have a random component to avoid clobbering a
-				 * local file */
+				/*
+				 * The data is received into a temporary file with a random
+				 * component in its name, so a local file is not clobbered.
+				 * The name is built in its own buffer: np may point at the
+				 * caller's argument string or at the shared directory name
+				 * buffer, and neither has room to grow.
+				 */
 				rand_str(rand_string, 8);
-				strcat(np, rand_string);
+				xasprintf(&np_rand, "%s%s", np_tmp, rand_string);
+				np = np_rand;
 #ifdef DEBUG
 				fprintf(stderr, "%s: Will concat %s to %s after xfer\n",
 					hostname, np, np_tmp);
@@ -2389,7 +2396,8 @@ sink(int argc, char **argv, const char *src)
 		fprintf(stderr, "%s: Creating file. mode is %d for %s\n",
 			hostname, mode, np);
 #endif
-		if ((ofd = open(np, O_WRONLY|O_CREAT, mode)) == -1) {
+		/* the temporary resume file must be new: never follow or reuse an existing name */
+		if ((ofd = open(np, O_WRONLY|O_CREAT|(np == np_rand ? O_EXCL : 0), mode)) == -1) {
 bad:			run_err("%s: %s", np, strerror(errno));
 			continue;
 		}
@@ -2580,6 +2588,9 @@ stopcat:		if (orig)
 			free(np_tmp);
 			np_tmp = NULL;
 		}
+		/* the temporary name is only used for one file */
+		free(np_rand);
+		np_rand = NULL;
         }
 done:
 	for (n = 0; n < npatterns; n++)
@@ -2887,7 +2898,7 @@ void rand_str(char *dest, size_t length) {
 		"ABCDEFGHIJKLMNOPQRSTUVWXYZ";
 
 	while (length-- > 0) {
-		size_t index = (double) rand() / RAND_MAX * (sizeof charset - 1);
+		size_t index = arc4random_uniform(sizeof charset - 1);
 		*dest++ = charset[index];
 	}
 	*dest = '\0';
