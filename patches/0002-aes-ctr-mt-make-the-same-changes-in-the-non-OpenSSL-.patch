+static void
+ssh_aes_ctr_get_threads(int *threads, int *numkq)
+{
+	const char *aes_threads = getenv("SSH_CIPHER_THREADS");
+	int t;
+
+	if (aes_threads != NULL && strlen(aes_threads) != 0) {
+		t = atoi(aes_threads);
+	} else
+		t = 1;
+
+	if (t < 1)
+		t = 1;
+	if (t > MAX_THREADS)
+		t = MAX_THREADS;
+
+	*threads = t;
+	*numkq = t + 1;
+	if (*numkq > MAX_NUMKQ)
+		*numkq = MAX_NUMKQ;
+}
