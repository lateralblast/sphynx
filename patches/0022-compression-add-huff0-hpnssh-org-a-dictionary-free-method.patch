+/*
+ * huff0@hpnssh.org keeps no state between packets, so it has nothing to
+ * start; every other method is zlib.
+ */
+static int
+comp_is_huff0(const struct sshcomp *comp)
+{
+	return comp != NULL && comp->name != NULL &&
+	    strcmp(comp->name, COMP_HUFF0_NAME) == 0;
+}
+
+static int
+start_compression(struct ssh *ssh, const struct sshcomp *comp, int mode)
+{
+	if (comp_is_huff0(comp))
+		return 0;
+	if (mode == MODE_OUT)
+		return start_compression_out(ssh);
+	return start_compression_in(ssh);
+}
+
+static int
+compress_packet(struct ssh *ssh, const struct sshcomp *comp,
+    struct sshbuf *in, struct sshbuf *out)
+{
+	if (comp_is_huff0(comp))
+		return huff0_compress(in, out);
+	return compress_buffer(ssh, in, out);
+}
+
+static int
+uncompress_packet(struct ssh *ssh, const struct sshcomp *comp,
+    struct sshbuf *in, struct sshbuf *out)
+{
+	if (comp_is_huff0(comp))
+		return huff0_uncompress(in, out, packet_max_size);
+	return uncompress_buffer(ssh, in, out);
+}
